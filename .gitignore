# The existing Azure project is kept locally as read-only source evidence. It is
# published and maintained in its own repository.
/azure-env/

# Terraform working data and local inputs.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
*-plan.json
crash.log
crash.*.log

# Terraform lock files are intentionally committed.
!.terraform.lock.hcl

# Credentials generated by google-github-actions/auth.
gha-creds-*.json

# Added from the bootstrap template only after the state bucket exists.
/terraform/bootstrap/gcp-foundation/backend.tf
/terraform/environments/*/backend.hcl

# Private learning notes and deployment journal. This may contain project IDs,
# billing details, plan observations and screenshots that are not for publishing.
/LOCAL-GCP-GUIDE.md
